# Dictionary loading may precede rowkey-doc completion; dependent builds must not.
--disable_warnings
DROP DATABASE IF EXISTS fts_dictionary_overlap;
--enable_warnings
CREATE DATABASE fts_dictionary_overlap DEFAULT CHARACTER SET utf8mb4;
USE fts_dictionary_overlap;
SET ob_query_timeout = 10000000000;
CREATE TABLE docs (id INT PRIMARY KEY, body TEXT, english TEXT);
INSERT INTO docs VALUES (1, '数据库', 'database'), (2, NULL, NULL), (3, '', ''), (4, '数据库', 'database');
CREATE FULLTEXT INDEX ft_ik ON docs(body) WITH PARSER ik;
SELECT id FROM docs WHERE MATCH(body) AGAINST('数据库') ORDER BY id;
CREATE FULLTEXT INDEX ft_beng ON docs(english) WITH PARSER beng;
SELECT id FROM docs WHERE MATCH(english) AGAINST('database') ORDER BY id;
UPDATE docs SET body = '数据库', english = 'database' WHERE id = 2;
DELETE FROM docs WHERE id = 1;
SELECT id FROM docs WHERE MATCH(body) AGAINST('数据库') ORDER BY id;
SELECT id FROM docs WHERE MATCH(english) AGAINST('database') ORDER BY id;
DROP INDEX ft_ik ON docs;
CREATE FULLTEXT INDEX ft_ik ON docs(body) WITH PARSER ik;
SELECT id FROM docs WHERE MATCH(body) AGAINST('数据库') ORDER BY id;
DROP DATABASE fts_dictionary_overlap;
